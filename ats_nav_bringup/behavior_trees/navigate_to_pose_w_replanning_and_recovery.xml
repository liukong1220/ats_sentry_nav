<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="NavigateRecovery"
                  number_of_retries="10">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="2.0">
          <RecoveryNode name="PlanAndSmoothOnTopologyChange"
                        number_of_retries="1">
            <Fallback>
              <ReactiveSequence name="KeepStableGlobalReference">
                <Inverter>
                  <GlobalUpdatedGoal/>
                </Inverter>
                <IsPathValid path="{path}"/>
              </ReactiveSequence>
              <Sequence name="ComputeStableGlobalReference">
                <ComputePathToPose goal="{goal}"
                                   path="{path_raw}"
                                   planner_id="GridBased"/>
                <SmoothPath unsmoothed_path="{path_raw}"
                            smoothed_path="{path}"
                            smoother_id="bspline_smoother"
                            max_smoothing_duration="0.15"
                            check_for_collisions="false"/>
              </Sequence>
            </Fallback>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context"
                                service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode name="FollowPath"
                      number_of_retries="10">
          <FollowElasticPath path="{path}"
                             controller_id="FollowPath"
                             elastic_path_topic="local_elastic_path"
                             elastic_path_timeout_s="0.8"
                             elastic_update_min_period_s="0.2"
                             goal_match_distance="0.25"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context"
                              service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree"
                                service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree"
                                service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <BackUp backup_dist="0.45"
                  backup_speed="0.25"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
