# Absolute Z obstacle height band in the ROGMap frame.
float32 min_height
float32 max_height
# Requested XY resolution. The server never samples finer than the occupancy map.
float32 resolution
# Use the ground-relative, ray-cleared global odom layer cropped to the
# configured computation window. False preserves the legacy raw Z projection.
bool use_odom_layer
# Zero disables identity checking for legacy callers. Mapping callers require both.
uint64 expected_odom_instance_id
uint64 expected_odom_epoch
---
# 0 free, 100 raw occupied, -1 unknown. Downstream owns metric clearance/inflation.
nav_msgs/OccupancyGrid occupancy_grid
uint64 generation
uint64 odom_instance_id
uint64 odom_epoch
bool odom_layer_included
bool ready
bool stale
# Row-major, metric signed distance. Positive is free, negative is occupied, NaN is unknown.
float32[] signed_distance
# Row-major gradient in occupancy_grid.header.frame_id. Unknown cells are NaN.
float32[] gradient_x
float32[] gradient_y
